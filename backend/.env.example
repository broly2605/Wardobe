# ---------------------------------------------------------------------------
# AI Personal Stylist — Backend configuration
# Copy this file to `.env` and fill in values. The `.env` file is gitignored.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Async SQLAlchemy connection string. To migrate to a cloud Postgres later,
# only this single line needs to change.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/wardrobe

# Sync URL used by Alembic migrations (same DB, sync driver).
DATABASE_URL_SYNC=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/wardrobe

# --- AI provider (OpenAI) -------------------------------------------------
# OPTIONAL. Leave blank to run fully offline with the rule-based stylist.
# When set, enables GPT styling advice and vision-based image auto-tagging.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# --- Storage --------------------------------------------------------------
# Directory (relative to backend/) where uploaded wardrobe images are stored.
UPLOAD_DIR=uploads

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- App ------------------------------------------------------------------
APP_ENV=development
